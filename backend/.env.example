# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the frontend URL)
CORS_ORIGINS=http://localhost:5173
# Public URL of the frontend, used in email links
APP_URL=http://localhost:5173
# Set true when behind a TLS-terminating proxy (Render, Railway, Fly, nginx)
TRUST_PROXY=false

# ---- Database ----
DATABASE_URL=postgresql://fitpulse:fitpulse@localhost:5432/fitpulse?schema=public

# ---- Sessions ----
SESSION_TTL_DAYS=30

# ---- Gemini (backend only - never expose to the frontend) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Daily AI request cap per user
AI_DAILY_LIMIT=50
# Return canned AI responses (local development/tests without a key)
GEMINI_MOCK=false

# ---- Image storage (Cloudinary). Leave blank to store uploads on local disk (dev only) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (SMTP). Leave SMTP_HOST blank to print emails to the console ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FitPulse <no-reply@fitpulse.app>"

# ---- Web push (generate with: npx web-push generate-vapid-keys) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- Scheduled reminders on Vercel (secret the cron caller must send as a Bearer token) ----
CRON_SECRET=
